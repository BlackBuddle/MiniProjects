  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #1a1a2e; }
QWidget#centralwidget { background-color: #1a1a2e; }
QLabel#titleLabel { color: #e0aaff; font-size: 28px; font-weight: bold; font-family: 'Segoe UI'; letter-spacing: 3px; }
QLabel#moveLabel { color: #c77dff; font-size: 16px; font-family: 'Segoe UI'; }
QLabel#difficultyLabel { color: #9d4edd; font-size: 14px; font-family: 'Segoe UI'; }
QPushButton#shuffleButton { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #7b2d8b,stop:1 #4a0e8f); color: #ffffff; font-size: 15px; font-weight: bold; border: 2px solid #c77dff; border-radius: 10px; padding: 8px 24px; }
QPushButton#shuffleButton:hover { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #9d3fac,stop:1 #6a2ebf); border-color: #e0aaff; }
QPushButton#shuffleButton:pressed { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #4a0e8f,stop:1 #2d006e); }
QComboBox#difficultyCombo { background-color: #240046; color: #e0aaff; font-size: 14px; border: 2px solid #7b2fbe; border-radius: 8px; padding: 5px 12px; min-width: 120px; }
QComboBox#difficultyCombo QAbstractItemView { background-color: #240046; color: #e0aaff; selection-background-color: #7b2fbe; border: 1px solid #7b2fbe; }
QPushButton { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #3c096c,stop:1 #240046); color: #e0aaff; font-size: 22px; font-weight: bold; border: 2px solid #7b2fbe; border-radius: 8px; }
QPushButton:hover { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #5a189a,stop:1 #3c096c); border-color: #c77dff; color: #ffffff; }
QPushButton:pressed { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #7b2fbe,stop:1 #5a189a); }
QFrame#separatorLine { color: #3c096c; }</string>
